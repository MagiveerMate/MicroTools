EXPO_PUBLIC_API_URL=https://api.example.com
PORT=3000
CORS_ORIGINS=*
DOCUMENT_PROCESSOR_URL=

# Subscription display configuration (safe for the mobile bundle)
EXPO_PUBLIC_PRO_DISPLAY_PRICE=€1.99
EXPO_PUBLIC_PRO_BILLING_PERIOD=month
EXPO_PUBLIC_PAYPAL_CHECKOUT_ENABLED=false

# PayPal server-only configuration. NEVER expose these as EXPO_PUBLIC_* values.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRODUCT_ID=
PAYPAL_PLAN_ID=
