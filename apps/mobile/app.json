{
  "expo": {
    "name": "MicroTools",
    "slug": "microtools",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.microtools.app"
    },
    "android": {
      "package": "com.microtools.app"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
