{
  "name": "microtools",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace apps/mobile start",
    "api": "npm --workspace services/api dev",
    "typecheck": "npm --workspaces run typecheck --if-present"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "uuid": "^11.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1",
    "query-string": "^9.5.1"
  }
}
